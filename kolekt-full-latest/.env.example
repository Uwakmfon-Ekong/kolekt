# ─── Kolekt environment variables ─────────────────────────────────────────────
# Copy this file to .env.local and fill it in. Never commit .env.local.

# Database. Leave empty to use the built-in local database (stored in ./.data).
# On Vercel this is required: use your Supabase "Transaction pooler" connection string (port 6543).
DATABASE_URL=

# Paga Collect API keys, from https://beta-business.paga.com (sandbox) or business.paga.com (live).
# Leave all three empty to run in demo mode with a built-in payment simulator.
PAGA_PUBLIC_KEY=
PAGA_SECRET_KEY=
PAGA_HASH_KEY=
# sandbox (default) or live
PAGA_ENV=sandbox

# Paga Business API (payouts to organisers' bank accounts). From the same Paga business dashboard:
# public ID, password and hash key for the Business API. Leave empty to use demo payouts.
# Note: Paga asks you to whitelist the server IP for the Business API.
PAGA_BUSINESS_PUBLIC_KEY=
PAGA_BUSINESS_PASSWORD=
PAGA_BUSINESS_HASH_KEY=

# Public URL of the app. Paga sends payment notifications to ${APP_URL}/api/webhooks/paga,
# so it must be reachable from the internet (your Vercel URL, or an ngrok tunnel locally).
APP_URL=

# Optional. Paga needs a payer email or phone number; if a contributor gives neither, this is used.
PAGA_PAYER_EMAIL=
# Optional. Share of Paga's collection fee paid by the contributor (0 = organiser pays it all, 1 = contributor pays it all).
PAGA_PAYER_FEE_SHARE=0
